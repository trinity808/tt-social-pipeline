# Copy this file to .env and fill in real values. Never commit .env itself.

# --- GCP ---
GCP_PROJECT_ID=

# --- LLM providers ---
# only needed if using Gemini via Vertex AI
VERTEX_AI_LOCATION=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_ORG_URN=
LINKEDIN_VERSION=202606          # rotates periodically -- check LinkedIn's API docs if posting starts failing with a version error

# --- Meta (Facebook + Instagram) ---
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0

# --- Image generation ---
OPENAI_API_KEY=                  # also used by the writer model (gpt-5.5), not just image generation
OPENAI_IMAGE_MODEL=gpt-image-2   # optional, falls back to gpt-image-2 if unset

# --- Emergency model overrides -- NOT for routine use ---
# Only set these if the default model is deprecated/unavailable. Changing
# either requires re-verifying grounding and JSON-parsing reliability
# before trusting it in production -- see the version dependencies section.
WRITER_MODEL=
CRITIC_MODEL=

# --- Runtime environment ---
ENVIRONMENT=development

# --- Cloud Run service role (defense-in-depth guard, see IAM & security) ---
# Leave unset (defaults to "private") for the main service.
# Set to "public" only on the reviewer-facing Cloud Run service.
SERVICE_ROLE=

# --- Human review email ---
REVIEW_EMAIL_FROM=
REVIEW_EMAIL_SENDER_NAME=Trinity Tree Social Review

# Testing / development
REVIEW_DEV_TO=
REVIEW_DEV_CC=

# Production (not yet in use -- recipient swap still pending)
REVIEW_PROD_TO=
REVIEW_PROD_CC=

# Public Cloud Run URL once deployed -- must point at the PUBLIC/review
# service specifically, set on BOTH services (see operational reference).
# Local development can use localhost.
REVIEW_PUBLIC_BASE_URL=http://localhost:8080

# SMTP
REVIEW_SMTP_HOST=smtp.gmail.com
REVIEW_SMTP_PORT=465

# --- Optional: LangGraph execution tracing (LangSmith) ---
# Free at this project's scale (~30 runs/month vs. 5,000 free-tier limit).
# Not currently set up or evaluated -- worth trying given it directly
# addresses debugging pause/resume behavior, which Cloud Logging alone
# has made harder to reason about (see Phase 5 notes).
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tt-social-pipeline